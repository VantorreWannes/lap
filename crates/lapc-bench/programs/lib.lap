BIT.ONE = NAND(BIT, NAND(BIT, BIT))
BIT.ZERO = NAND(BIT.ONE, BIT.ONE)

U8 = [BIT, BIT, BIT, BIT, BIT, BIT, BIT, BIT]
U64 = [
    BIT, BIT, BIT, BIT, BIT, BIT, BIT, BIT,
