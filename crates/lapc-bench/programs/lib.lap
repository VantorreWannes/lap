OP.STREAM.WRITE = [U8.TWO, U8.TWO]
OP.CLOCK.MONOTONIC = [U8.ZERO, U8.THREE]
STREAM.OUT = U64.ONE

// An erased function is declared with an empty collection. The compiler knows
// its signature from the label, and the erasure pass replaces the body with the
// intrinsic.
liblapc.bit.not = []
liblapc.bit.and = []
liblapc.bit.or = []
liblapc.bit.xor = []
liblapc.bit.select = []

