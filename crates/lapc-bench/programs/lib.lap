U128.ZERO = [U64.ZERO, U64.ZERO]
U128.ONE = [U64.ONE, U64.ZERO]

OP.STREAM.WRITE = [U8.TWO, U8.TWO]
OP.CLOCK.MONOTONIC = [U8.ZERO, U8.THREE]
STREAM.OUT = U64.ONE

// An erased function is declared with an empty collection. The compiler knows
// its signature from the label, and the erasure pass replaces the body with the
// intrinsic. Only a label prefixed with intrinsic. is recognized.
intrinsic.bit.not = []
intrinsic.bit.and = []
intrinsic.bit.or = []
intrinsic.bit.exclusive.or = []
intrinsic.bit.select = []

intrinsic.u8.add.with.carry = []
intrinsic.u8.sub.with.borrow = []
intrinsic.u8.and = []
intrinsic.u8.or = []
intrinsic.u8.exclusive.or = []
intrinsic.u8.not = []
intrinsic.u8.shift.left.one = []
intrinsic.u8.shift.right.one = []

intrinsic.u64.add.with.carry = []
intrinsic.u64.sub.with.borrow = []
intrinsic.u64.and = []
intrinsic.u64.or = []
intrinsic.u64.exclusive.or = []
intrinsic.u64.not = []
intrinsic.u64.shift.left.one = []
intrinsic.u64.shift.right.one = []

liblapc.bit.not = (value: BIT) BIT {
    intrinsic.bit.not(value)
}

liblapc.bit.and = (left: BIT, right: BIT) BIT {
    intrinsic.bit.and(left, right)
}

liblapc.bit.or = (left: BIT, right: BIT) BIT {
    intrinsic.bit.or(left, right)
}

liblapc.bit.xor = (left: BIT, right: BIT) BIT {
    intrinsic.bit.exclusive.or(left, right)
}

liblapc.bit.select = (flag: BIT, when.one: BIT, when.zero: BIT) BIT {
    intrinsic.bit.select(flag, when.one, when.zero)
}

liblapc.u8.add = (left: U8, right: U8) U8 {
    [sum, carry] = intrinsic.u8.add.with.carry(left, right, BIT.ZERO)
    sum
}

liblapc.u8.sub = (left: U8, right: U8) U8 {
    [difference, borrow] = intrinsic.u8.sub.with.borrow(left, right, BIT.ZERO)
    difference
}

liblapc.u8.xor = (left: U8, right: U8) U8 {
    intrinsic.u8.exclusive.or(left, right)
}

liblapc.u8.and = (left: U8, right: U8) U8 {
    intrinsic.u8.and(left, right)
}

liblapc.u8.or = (left: U8, right: U8) U8 {
    intrinsic.u8.or(left, right)
}

liblapc.u8.not = (value: U8) U8 {
    intrinsic.u8.not(value)
}

liblapc.u8.shift.left.one = (value: U8) U8 {
    intrinsic.u8.shift.left.one(value)
}

liblapc.u8.shift.right.one = (value: U8) U8 {
    intrinsic.u8.shift.right.one(value)
}

liblapc.u8.lt = (left: U8, right: U8) BIT {
    [difference, borrow] = intrinsic.u8.sub.with.borrow(left, right, BIT.ZERO)
    borrow
}

liblapc.u8.is.zero = (value: U8) BIT {
    [difference, borrow] = intrinsic.u8.sub.with.borrow(U8.ZERO, value, BIT.ZERO)
    intrinsic.bit.not(borrow)
}

liblapc.u8.eq = (left: U8, right: U8) BIT {
    [difference, borrow] = intrinsic.u8.sub.with.borrow(left, right, BIT.ZERO)
    liblapc.u8.is.zero(difference)
}

liblapc.u64.add = (left: U64, right: U64) U64 {
    [sum, carry] = intrinsic.u64.add.with.carry(left, right, BIT.ZERO)
    sum
}

liblapc.u64.sub = (left: U64, right: U64) U64 {
    [difference, borrow] = intrinsic.u64.sub.with.borrow(left, right, BIT.ZERO)
    difference
}

liblapc.u64.xor = (left: U64, right: U64) U64 {
    intrinsic.u64.exclusive.or(left, right)
}

liblapc.u64.and = (left: U64, right: U64) U64 {
    intrinsic.u64.and(left, right)
}

liblapc.u64.or = (left: U64, right: U64) U64 {
    intrinsic.u64.or(left, right)
}

liblapc.u64.not = (value: U64) U64 {
    intrinsic.u64.not(value)
}

liblapc.u64.shift.left.one = (value: U64) U64 {
    intrinsic.u64.shift.left.one(value)
}

liblapc.u64.shift.right.one = (value: U64) U64 {
    intrinsic.u64.shift.right.one(value)
}

liblapc.u64.lt = (left: U64, right: U64) BIT {
    [difference, borrow] = intrinsic.u64.sub.with.borrow(left, right, BIT.ZERO)
    borrow
}

liblapc.u64.is.zero = (value: U64) BIT {
    [difference, borrow] = intrinsic.u64.sub.with.borrow(U64.ZERO, value, BIT.ZERO)
    intrinsic.bit.not(borrow)
}

liblapc.u64.eq = (left: U64, right: U64) BIT {
    [difference, borrow] = intrinsic.u64.sub.with.borrow(left, right, BIT.ZERO)
    liblapc.u64.is.zero(difference)
}

write.byte = (byte: U8) [] {
    [sent] = EXTERN(OP.STREAM.WRITE, STREAM.OUT, byte)
}

write.u64 = (value: U64) [] {
    [b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15,
     b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31,
     b32, b33, b34, b35, b36, b37, b38, b39, b40, b41, b42, b43, b44, b45, b46, b47,
     b48, b49, b50, b51, b52, b53, b54, b55, b56, b57, b58, b59, b60, b61, b62, b63] = value
    write.byte([b0, b1, b2, b3, b4, b5, b6, b7])
    write.byte([b8, b9, b10, b11, b12, b13, b14, b15])
    write.byte([b16, b17, b18, b19, b20, b21, b22, b23])
    write.byte([b24, b25, b26, b27, b28, b29, b30, b31])
    write.byte([b32, b33, b34, b35, b36, b37, b38, b39])
    write.byte([b40, b41, b42, b43, b44, b45, b46, b47])
    write.byte([b48, b49, b50, b51, b52, b53, b54, b55])
    write.byte([b56, b57, b58, b59, b60, b61, b62, b63])
}
